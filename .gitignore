# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Test and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# Build artifacts
build/
dist/
*.egg-info/

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local model and notebook caches
.cache/

# Optional local runtime files
*.log

# Keep deliverables tracked
!outputs/
!outputs/*.json